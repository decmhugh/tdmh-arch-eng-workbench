        </mxCell>
        <mxCell id="prd_role" value="Axis B lives in here — see note below&#10;The one control plane, and the PROD gateways" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#B85450;" vertex="1" parent="acct_prd">
          <mxGeometry x="14" y="428" width="356" height="34" as="geometry" />
        </mxCell>

        <mxCell id="bedrock" value="Bedrock — in-account, in every environment" style="rounded=1;html=1;whiteSpace=wrap;container=1;collapsible=0;fillColor=#FAFAFA;strokeColor=#546E7A;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontSize=11;fontStyle=1;fontColor=#37474F;" vertex="1" parent="region">
          <mxGeometry x="30" y="584" width="760" height="110" as="geometry" />
        </mxCell>
        <mxCell id="bedrock_note" value="Each gateway calls Bedrock in the account and region it runs in, with its own role (hub role luminate-gateway-irsa; -us in us-east-1). No keys and no shared spoke account. The SCP permits only approved models, so a model that is registered but not approved fails at AWS." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#37474F;" vertex="1" parent="bedrock">
          <mxGeometry x="14" y="32" width="732" height="66" as="geometry" />
        </mxCell>

        <mxCell id="axisB" value="AXIS B · workload environments — where business teams actually deploy" style="rounded=1;html=1;whiteSpace=wrap;container=1;collapsible=0;fillColor=#F6F3FB;strokeColor=#4527A0;verticalAlign=top;align=left;spacingLeft=12;fontSize=11;fontStyle=1;fontColor=#4527A0;" vertex="1" parent="region">
          <mxGeometry x="818" y="584" width="772" height="110" as="geometry" />
        </mxCell>
        <mxCell id="axisB_note" value="The four accounts above are installs of the product, not where a business team promotes a workload. DEV · SIT · STAGE · PROD are rows inside the prod install: one control plane, one catalogue, one audit trail. Target: each environment's gateways run in that environment's account above, in ca-central-1 and us-east-1, and reach the prod control plane over an outbound TLS control link. Today all eight run in the prod account. Owned by the gateway-environment-strategy spec." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#4527A0;" vertex="1" parent="axisB">
          <mxGeometry x="14" y="32" width="744" height="66" as="geometry" />
        </mxCell>

        <mxCell id="regionnote" value="Serving regions are ca-central-1 and us-east-1, and the list is open. A region adds gateways in each environment's account — never another set of these installs, which stay in ca-central-1. Deploying the whole application per region is an anti-pattern: it forks the catalogue, the governance record and the audit trail." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#147EBA;" vertex="1" parent="region">
          <mxGeometry x="30" y="712" width="1560" height="40" as="geometry" />
        </mxCell>

