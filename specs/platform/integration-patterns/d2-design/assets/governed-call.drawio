          <mxGeometry x="1130" y="120" width="350" height="340" as="geometry" />
        </mxCell>
        <mxCell id="model" value="Model provider&#10;Bedrock — whose account depends on the pattern" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontSize=12;fontStyle=1;verticalAlign=middle;fontColor=#4472A8;" vertex="1" parent="up">
          <mxGeometry x="25" y="50" width="300" height="76" as="geometry" />
