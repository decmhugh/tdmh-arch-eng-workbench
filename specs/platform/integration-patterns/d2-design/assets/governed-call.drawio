        <mxCell id="s45" value="4 · CheckAccess gRPC&#10;5 · allow / deny + guardrails" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673A6;fontSize=11;startArrow=classic;startFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="cp" source="gw" target="portal">
