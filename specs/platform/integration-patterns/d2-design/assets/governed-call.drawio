        <mxCell id="gw" value="Gateway&#10;&#10;/llm  ·  /mcp  ·  /a2a" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;verticalAlign=middle;fontColor=#1B5E20;" vertex="1" parent="cp">
          <mxGeometry x="40" y="230" width="240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="policy" value="Policy decision&#10;&#10;access policies · quotas&#10;guardrails · kill switch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;verticalAlign=middle;fontColor=#7F6000;" vertex="1" parent="cp">
          <mxGeometry x="340" y="50" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="cpfoot" value="Authorization happens HERE, centrally — never in your app, and never in the upstream provider.&#10;One identity, one policy decision, one audit record, whichever pattern you picked." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#4527A0;" vertex="1" parent="cp">
