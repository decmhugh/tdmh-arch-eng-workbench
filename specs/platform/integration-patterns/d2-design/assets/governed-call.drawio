        <mxCell id="foot" value="The patterns differ only in step 6 — whose account's Bedrock is invoked, and therefore who AWS bills. Steps 1 to 5 are identical whichever pattern you chose." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#147EBA;" vertex="1" parent="1">
