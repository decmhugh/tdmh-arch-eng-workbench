<mxfile host="acp-product-specs" agent="copilot" version="1">
  <diagram id="inference-patterns" name="Inference patterns — I1 consumer-account vs I2 centralized">
    <mxGraphModel dx="1800" dy="830" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="panelA" value="I1 · CONSUMER-ACCOUNT — the default where the team has an AWS account" style="rounded=1;html=1;whiteSpace=wrap;container=1;collapsible=0;fillColor=#F1F8F2;strokeColor=#2E7D32;verticalAlign=top;align=left;spacingLeft=14;fontSize=14;fontStyle=1;fontColor=#1B5E20;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1020" height="700" as="geometry" />
        </mxCell>

        <mxCell id="wlA" value="Workload&#10;any hosting shape&#10;holds no Bedrock credential" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#546E7A;fontSize=11;fontStyle=1;verticalAlign=middle;" vertex="1" parent="panelA">
          <mxGeometry x="30" y="46" width="230" height="72" as="geometry" />
        </mxCell>
        <mxCell id="noteA0" value="The gateway makes the Bedrock call in both patterns. What changes is whose account it executes in — and therefore who AWS bills." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#37474F;" vertex="1" parent="panelA">
          <mxGeometry x="285" y="46" width="700" height="72" as="geometry" />
        </mxCell>

        <mxCell id="awsA" value="AWS Cloud" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="panelA">
          <mxGeometry x="30" y="140" width="960" height="530" as="geometry" />
        </mxCell>

        <mxCell id="hub" value="Account · ACP hub (control plane)" style="rounded=1;html=1;whiteSpace=wrap;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#B85450;verticalAlign=top;align=center;fontSize=12;fontStyle=1;fontColor=#B85450;spacingTop=4;" vertex="1" parent="awsA">
          <mxGeometry x="25" y="55" width="430" height="380" as="geometry" />
        </mxCell>
        <mxCell id="gwpod" value="Gateway pod&#10;/llm · /mcp · /a2a" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;verticalAlign=middle;fontColor=#1B5E20;" vertex="1" parent="hub">
          <mxGeometry x="20" y="44" width="390" height="62" as="geometry" />
        </mxCell>
        <mxCell id="scpdenyA" value="SCP DENIES bedrock:* and bedrock-agentcore:*&#10;— this is why the chain exists at all" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontStyle=1;verticalAlign=middle;fontColor=#7F1D1D;" vertex="1" parent="hub">
          <mxGeometry x="20" y="120" width="390" height="58" as="geometry" />
        </mxCell>
        <mxCell id="chain" value="AWS_PROFILE=chain — a mounted shared-config file&#10;&#10;base : web identity token → ACP hub role&#10;chain : hub role → consumer spoke role&#10;&#10;Resolved by the default provider chain, so no&#10;application code knows about it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#999999;dashed=1;fontSize=10;verticalAlign=middle;align=left;spacingLeft=10;fontColor=#555555;" vertex="1" parent="hub">
          <mxGeometry x="20" y="192" width="390" height="160" as="geometry" />
        </mxCell>

        <mxCell id="spoke" value="Account · consumer spoke (the business team's own)" style="rounded=1;html=1;whiteSpace=wrap;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#2E7D32;verticalAlign=top;align=center;fontSize=12;fontStyle=1;fontColor=#2E7D32;spacingTop=4;" vertex="1" parent="awsA">
          <mxGeometry x="495" y="55" width="430" height="380" as="geometry" />
        </mxCell>
        <mxCell id="roles" value="Four /delegated/ roles, self-provisioned from an&#10;AWS Service Catalog product — no Cloud ticket&#10;&#10;acp-gateway-xaccount   ← the inference path&#10;acp-eval-judge · acp-agent-discovery&#10;acp-bedrock-agent-exec&#10;&#10;Boundary: slf-aws-delegated-perm-boundary&#10;Trust: ACP hub principal + ExternalId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;verticalAlign=middle;align=left;spacingLeft=10;fontColor=#7F6000;" vertex="1" parent="spoke">
          <mxGeometry x="20" y="44" width="390" height="184" as="geometry" />
        </mxCell>
        <mxCell id="brA" value="Bedrock — enabled here&#10;SCPs are evaluated in THIS account" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;verticalAlign=middle;fontColor=#1B5E20;" vertex="1" parent="spoke">
          <mxGeometry x="20" y="244" width="390" height="62" as="geometry" />
        </mxCell>
        <mxCell id="billA" value="AWS bills the consumer directly — no chargeback machinery required" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;fontStyle=1;verticalAlign=middle;fontColor=#1B5E20;" vertex="1" parent="spoke">
          <mxGeometry x="20" y="320" width="390" height="42" as="geometry" />
        </mxCell>

        <mxCell id="statusA" value="Status: the Service Catalog product is published and verified end to end — launch creates all four roles, terminate removes them cleanly. What has not happened is the rollout: all three environments still point at ONE shared test spoke, so the multi-consumer shape is unproven." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#37474F;" vertex="1" parent="awsA">
          <mxGeometry x="25" y="450" width="900" height="60" as="geometry" />
        </mxCell>

        <mxCell id="eA1" value="Bearer JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="panelA" source="wlA" target="awsA">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eA2" value="sts:AssumeRole&#10;+ ExternalId" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2E7D32;fontSize=10;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="awsA" source="hub" target="spoke">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="panelB" value="I2 · CENTRALIZED — for teams with no AWS account" style="rounded=1;html=1;whiteSpace=wrap;container=1;collapsible=0;fillColor=#FFFDF5;strokeColor=#F9A825;verticalAlign=top;align=left;spacingLeft=14;fontSize=14;fontStyle=1;fontColor=#7F6000;" vertex="1" parent="1">
          <mxGeometry x="1090" y="40" width="670" height="700" as="geometry" />
        </mxCell>

        <mxCell id="wlB" value="Workload&#10;OpenShift / K8s&#10;no AWS account to assume into" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#546E7A;fontSize=11;fontStyle=1;verticalAlign=middle;" vertex="1" parent="panelB">
          <mxGeometry x="30" y="46" width="230" height="72" as="geometry" />
        </mxCell>
        <mxCell id="noteB0" value="No spoke, no assume-role. Simpler in every respect except two — and both are real." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#37474F;" vertex="1" parent="panelB">
          <mxGeometry x="285" y="46" width="350" height="72" as="geometry" />
        </mxCell>

        <mxCell id="awsB" value="AWS Cloud" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="panelB">
          <mxGeometry x="30" y="140" width="610" height="530" as="geometry" />
        </mxCell>

        <mxCell id="acctB" value="Account · ACP workload (the same one the gateway runs in)" style="rounded=1;html=1;whiteSpace=wrap;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#B85450;verticalAlign=top;align=center;fontSize=12;fontStyle=1;fontColor=#B85450;spacingTop=4;" vertex="1" parent="awsB">
          <mxGeometry x="25" y="55" width="560" height="380" as="geometry" />
        </mxCell>
        <mxCell id="gwpodB" value="Gateway pod — calls Bedrock with its OWN pod role" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;verticalAlign=middle;fontColor=#1B5E20;" vertex="1" parent="acctB">
          <mxGeometry x="20" y="44" width="520" height="62" as="geometry" />
        </mxCell>
        <mxCell id="brB" value="Bedrock — in this same account&#10;NOT ENABLED TODAY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;dashed=1;fontSize=12;fontStyle=1;verticalAlign=middle;fontColor=#B85450;" vertex="1" parent="acctB">
          <mxGeometry x="20" y="132" width="520" height="62" as="geometry" />
        </mxCell>
        <mxCell id="blk1" value="BLOCKER 1 — the same SCP deny applies here. &quot;Enable Bedrock in the ACP account&quot; means lifting an org-level SCP on the account hosting the control plane, or hosting the gateway where the deny does not apply. That is a governance decision, not a console toggle." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;verticalAlign=middle;align=left;spacingLeft=10;fontColor=#7F1D1D;" vertex="1" parent="acctB">
          <mxGeometry x="20" y="208" width="520" height="72" as="geometry" />
        </mxCell>
        <mxCell id="blk2" value="BLOCKER 2 — ACP pays. Without attribution and recovery, a business unit's model spend lands on the platform budget. Chargeback is the gate on this pattern." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;verticalAlign=middle;align=left;spacingLeft=10;fontColor=#7F1D1D;" vertex="1" parent="acctB">
          <mxGeometry x="20" y="292" width="520" height="62" as="geometry" />
        </mxCell>

        <mxCell id="statusB" value="Status: gated. The pattern is coherent and the mechanism is trivial — it is the two blockers above that keep it unavailable, and neither is an engineering task." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#37474F;" vertex="1" parent="awsB">
          <mxGeometry x="25" y="450" width="560" height="60" as="geometry" />
        </mxCell>

        <mxCell id="eB1" value="Bearer JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#546E7A;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="panelB" source="wlB" target="awsB">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="foot" value="Hosting — the team's AWS account, a Bedrock AgentCore runtime, or OpenShift/Kubernetes — is a separate, independent choice that composes with either pattern. The only hard constraint: no AWS account means centralized, because there is nothing to assume into." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#147EBA;" vertex="1" parent="1">
          <mxGeometry x="40" y="756" width="1720" height="44" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
