<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" modified="2026-09-03T00:00:00.000Z" agent="acp-product-specs" version="24.0.0" type="device">
  <diagram id="aims-target-topology" name="AIMS target topology">
    <mxGraphModel dx="1800" dy="1200" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="AIMS on Luminate — target topology for the POC" style="text;html=0;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="12" width="900" height="28" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Every solid arrow out of an AIMS component passes through the gateway — the only path on which policy, guardrails, audit, tracing and cost exist. A direct provider call is not &quot;less governed&quot;, it is ungoverned." style="text;html=0;fontSize=11;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="38" width="1320" height="18" as="geometry" />
        </mxCell>
        <mxCell id="subtitle2" value="Traffic leaves the AIMS estate to be governed and comes back into it — the gateway reaches the MCP servers on cluster-internal Service addresses, below the Okta hop (DD-4)." style="text;html=0;fontSize=11;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="56" width="1320" height="18" as="geometry" />
        </mxCell>

        <!-- ── AIMS estate ────────────────────────────────────────────── -->
        <mxCell id="aims" value="AIMS estate — Corp IT" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f9f9f9;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacing=8;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="30" y="96" width="600" height="872" as="geometry" />
        </mxCell>

        <mxCell id="callersbox" value="Callers — registered separately, one credential each per (resource, gateway)   DD-7" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;align=left;spacing=8;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="56" y="132" width="552" height="296" as="geometry" />
        </mxCell>

        <mxCell id="det" value="Detection pipeline   ·   aims-detection-pipeline&#10;an Application, not an Agent — it summarises, it does not act   DD-2" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacing=8;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="100" y="168" width="484" height="50" as="geometry" />
        </mxCell>
        <mxCell id="rca" value="RCA Agent   ·   aims-rca&#10;Haiku + Sonnet · knowledge base · AWS ops READ" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=middle;spacing=8;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="100" y="230" width="484" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cor" value="Incident Correlation Agent   ·   aims-incident-correlation&#10;Haiku + Sonnet · Jira · Teams · knowledge base · AWS ops READ" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=middle;spacing=8;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="100" y="292" width="484" height="50" as="geometry" />
        </mxCell>
        <mxCell id="rem" value="Remediation Agent   ·   aims-remediation&#10;S4 — not registered until G4 (stop control) and G11 resolve" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#b3b3b3;dashed=1;align=left;verticalAlign=middle;spacing=8;fontSize=11;fontColor=#8c8c8c;" vertex="1" parent="1">
          <mxGeometry x="100" y="354" width="484" height="50" as="geometry" />
        </mxCell>

        <mxCell id="a2al" value="The dashed red hops are direct calls between agents, at their own service addresses. They do not pass&#10;through Luminate and cannot today (G3). Each agent re-enters the gateway on its own identity for its own&#10;egress, so governance is complete per hop and absent between hops." style="text;html=0;fontSize=10;fontColor=#b85450;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="100" y="442" width="500" height="48" as="geometry" />
        </mxCell>

        <mxCell id="mcpbox" value="MCP servers — registered on cluster-internal Service addresses, below the Okta-fronted Route   DD-4&#10;Split by blast radius, not by system: one registered server per trust boundary   DD-5" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;align=left;spacing=8;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="56" y="510" width="552" height="424" as="geometry" />
        </mxCell>

        <mxCell id="jira" value="aims-jira   —   transport http or sse, never stdio" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="566" width="484" height="44" as="geometry" />
        </mxCell>
        <mxCell id="teams" value="aims-teams" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="620" width="484" height="44" as="geometry" />
        </mxCell>
        <mxCell id="kb" value="aims-knowledge-base" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="674" width="484" height="44" as="geometry" />
        </mxCell>
        <mxCell id="opsread" value="aims-aws-ops-read   —   read-only tool set" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacing=8;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="100" y="728" width="484" height="44" as="geometry" />
        </mxCell>
        <mxCell id="opswrite" value="aims-aws-ops-write   —   registered, but no policy grants it until S4&#10;same implementation as read, disjoint tool set, different path" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;align=left;verticalAlign=middle;spacing=8;fontSize=11;fontColor=#9c4a45;" vertex="1" parent="1">
          <mxGeometry x="100" y="782" width="484" height="50" as="geometry" />
        </mxCell>
        <mxCell id="mcpnote" value="No agent in the POC reaches the write server. The only path to infrastructure change is the S4 agent,&#10;which does not exist yet. Each server keeps enforcing its own authorization internally — Luminate is an&#10;additional layer, never a replacement for it." style="text;html=0;fontSize=10;fontColor=#888888;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="100" y="850" width="500" height="48" as="geometry" />
        </mxCell>

        <!-- ── Luminate ───────────────────────────────────────────────── -->
        <mxCell id="lum" value="Luminate — dev only, one gateway, one environment   DD-10" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f4f8fd;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacing=8;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="720" y="96" width="420" height="872" as="geometry" />
        </mxCell>

        <mxCell id="portal" value="Portal / control plane&#10;catalog · access policy · IAM · token endpoint" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacing=8;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="744" y="146" width="372" height="56" as="geometry" />
        </mxCell>
        <mxCell id="kc" value="Keycloak   —   one OAuth2 client per credential" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=middle;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="744" y="222" width="372" height="44" as="geometry" />
        </mxCell>

        <mxCell id="gw" value="Gateway&#10;/llm   ·   /mcp&#10;&#10;the trust boundary — policy, guardrails, audit, tracing, cost" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;spacing=8;fontSize=13;fontStyle=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="744" y="404" width="372" height="116" as="geometry" />
        </mxCell>

        <mxCell id="lf" value="Langfuse   —   traces, usage and cost, per agent and per model&#10;Platform owns the request, AIMS owns the task, the trace id joins them   DD-9" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacing=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="744" y="700" width="372" height="56" as="geometry" />
        </mxCell>

        <mxCell id="lumnote" value="Test, stage and prod are not available. Every credential,&#10;deployment and policy created here is dev-scoped and will&#10;need re-creating per environment later — a deployment is&#10;per (resource, gateway) and does not travel." style="text;html=0;fontSize=10;fontColor=#888888;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="744" y="800" width="372" height="60" as="geometry" />
        </mxCell>

        <!-- ── Bedrock ────────────────────────────────────────────────── -->
        <mxCell id="br" value="AWS Bedrock — ca-central-1&#10;&#10;Claude Haiku       default, routine classification&#10;Claude Sonnet     escalation, correlation and reasoning&#10;&#10;Keyless where possible   DD-3" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacing=10;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1230" y="394" width="300" height="136" as="geometry" />
        </mxCell>

