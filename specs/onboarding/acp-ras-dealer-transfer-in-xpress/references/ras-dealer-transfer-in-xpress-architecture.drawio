        <mxCell id="J38ydGdJebyKz1XrtzWe-8" parent="1" style="text;whiteSpace=wrap;fontSize=9;fontColor=#CC0000;fontStyle=3" value="Data Purger Lambda" vertex="1">
          <mxGeometry height="40" width="70" x="994" y="237.5" as="geometry" />
        </mxCell>
        <mxCell id="J38ydGdJebyKz1XrtzWe-9" parent="1" style="text;whiteSpace=wrap;fontSize=9;fontStyle=3;verticalAlign=middle;fontColor=#CC0000;" value="Daily Run&#xa;Scheduled" vertex="1">
          <mxGeometry height="47.8" width="38.45" x="1043.55" y="200.1" as="geometry" />
        </mxCell>
        <mxCell id="J38ydGdJebyKz1XrtzWe-10" parent="1" style="text;whiteSpace=wrap;html=1;fontSize=10;align=center;fontColor=#CC0000;fontStyle=1" value="S3 Lifecycle Rule&lt;div&gt;(&amp;gt;90 Days old data)&lt;/div&gt;" vertex="1">
          <mxGeometry height="25.4" width="130" x="459" y="191.6" as="geometry" />
        </mxCell>
        <mxCell id="H9lZCcJ5EyIwc4zvm-jB-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=11;" value="&lt;div&gt;&lt;b&gt;Steps&lt;/b&gt;&lt;/div&gt;&lt;ol style=&quot;line-height: 150%;&quot;&gt;&lt;li&gt;&lt;span&gt;&lt;b&gt;User Uploads Transfer Form : UI (React)&lt;/b&gt; : User uploads Transfer Form (PDF) via the web interface&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span&gt;&lt;b&gt;File Upload to S3 : API (Node.js) &lt;/b&gt;: API receives the file and uploads it to AWS S3 bucket&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span&gt;&lt;b&gt;User Initiates Validation :&lt;/b&gt; UI (React) : User clicks &quot;Start Validation&quot; button to begin processing&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span&gt;&lt;b&gt;Lambda Triggered : AWS Lambda :&lt;/b&gt; &quot;Start Validation&quot; click triggers the AWS Lambda function&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span&gt;&lt;b&gt;Retrieve Uploaded Form : AWS Lambda + S3 :&lt;/b&gt; Lambda retrieves the user-uploaded form from S3&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span&gt;&lt;b&gt;Data Extraction : AWS Bedrock (LLM) : &lt;/b&gt;Bedrock LLM extracts data from PDF and returns JSON output&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span&gt;&lt;b&gt;Fetch Univeris Data : Univeris API : &lt;/b&gt;Fetches Contract and Client details using extracted contract_id&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span&gt;&lt;b&gt;Validation : AWS Bedrock (LLM) :&lt;/b&gt; Bedrock LLM validates data and returns IGO/NIGO + ATON/NON-ATON status&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span&gt;&lt;b&gt;Store Results : AWS RDS (PostgreSQL) : &lt;/b&gt;Saves extracted data and validation results to PostgreSQL database&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span&gt;&lt;b&gt;Display Results : UI (React) :&lt;/b&gt; Final results are retrieved from database and displayed on the UI&lt;/span&gt;&lt;/li&gt;&lt;li&gt;When validation fails due to an owner name and Rep Code mismatch between form data and Univeris, the user is given the option to confirm that both are the same. They can then revalidate. If confirmed, this mapping is stored in the database, and revalidation resumes from Step 4 onwards.&lt;/li&gt;&lt;li&gt;When the user presses the &quot;Validation Record&quot; button, the system fetches the previous validation report from the database and displays it based on the selected date range.&lt;/li&gt;&lt;li&gt;Users use the Download Report feature to download the validation report for selected dates.&lt;/li&gt;&lt;/ol&gt;&lt;div&gt;&lt;div&gt;&lt;span&gt;&lt;b&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;Logging and Data Purging&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;span&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;&lt;b&gt;Non-PII data only is logged to CloudWatch (job start/end time, file name, status, etc.)&lt;/b&gt;&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;&lt;b&gt;Data Purger Lambda runs daily to delete records older than 90 days from the database&lt;/b&gt;&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;&lt;b&gt;S3 Lifecycle Rule automatically purges data older than 90 days from S3&lt;/b&gt;&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="290" width="1102.91" x="160" y="540" as="geometry" />
        </mxCell>
        <mxCell id="pdoQQOn0OO0ORJM7pZQo-1" parent="1" style="text;whiteSpace=wrap;fontSize=10;fontStyle=3" value="API Call" vertex="1">
          <mxGeometry height="20" width="50" x="588" y="403" as="geometry" />
        </mxCell>
