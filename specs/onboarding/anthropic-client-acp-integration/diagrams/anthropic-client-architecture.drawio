          <mxGeometry x="295" y="48" width="225" height="52" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="ProjectUsageDaily ledger&#10;user_id, user_email, cost_centre" style="rounded=1;html=0;whiteSpace=wrap;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="laneE">
          <mxGeometry x="570" y="48" width="250" height="52" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="Chargeback API&#10;filter by user_ids" style="rounded=1;html=0;whiteSpace=wrap;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="laneE">
          <mxGeometry x="870" y="48" width="225" height="52" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="CloudTrail and Cost &amp; Usage Report&#10;STS session name, optional project tag" style="rounded=1;html=0;whiteSpace=wrap;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="laneE">
          <mxGeometry x="1145" y="48" width="225" height="52" as="geometry" />
        </mxCell>

        <mxCell id="warn" value="BLOCKED TODAY: no model is both IAM-approved and Marketplace-subscribed except Claude 3 Haiku, which has no prompt caching — which Claude Code requires." style="rounded=0;html=0;whiteSpace=wrap;fontSize=12;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="574" width="1390" height="38" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="A shared machine credential would make every user the same principal, so the ledger would hold one row per day for the whole population. Attribution is lost at capture, not downstream." style="text;html=0;fontSize=11;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="30" y="620" width="1390" height="20" as="geometry" />
        </mxCell>

