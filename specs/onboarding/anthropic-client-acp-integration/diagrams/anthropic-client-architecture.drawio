<mxfile host="app.diagrams.net" modified="2026-09-14T00:00:00.000Z" agent="acp-product-specs" version="24.0.0" type="device">
  <diagram id="anthropic-client-architecture" name="Anthropic client through ACP">
    <mxGraphModel dx="1800" dy="1100" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Anthropic client products through ACP — governed inference with per-user attribution" style="text;html=0;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="10" width="1100" height="26" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="D2 DD-1: the identity on the request decides BOTH access and cost attribution. Measured against dev, 2026-09-14." style="text;html=0;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="30" y="36" width="1100" height="20" as="geometry" />
        </mxCell>

        <mxCell id="laneB" value="Enterprise identity" style="swimlane;html=0;startSize=26;fontSize=12;fontStyle=1;fillColor=none;strokeColor=#d6b656;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="72" width="260" height="300" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="Desktop SSO token" style="rounded=1;html=0;whiteSpace=wrap;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="laneB">
          <mxGeometry x="20" y="42" width="220" height="52" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="AD group&#10;ENTITLEMENT ONLY (DD-2)" style="rounded=1;html=0;whiteSpace=wrap;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="laneB">
          <mxGeometry x="20" y="116" width="220" height="52" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="A group does not travel&#10;on a request, so it cannot&#10;attribute. No device flow&#10;(RFC 8628) either. (DD-3)" style="rounded=0;html=0;whiteSpace=wrap;fontSize=10;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;" vertex="1" parent="laneB">
          <mxGeometry x="20" y="190" width="220" height="74" as="geometry" />
        </mxCell>

        <mxCell id="laneA" value="Managed laptop" style="swimlane;html=0;startSize=26;fontSize=12;fontStyle=1;fillColor=none;strokeColor=#6c8ebf;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="320" y="72" width="290" height="300" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="apiKeyHelper&#10;re-runs on TTL below 300 s" style="rounded=1;html=0;whiteSpace=wrap;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="laneA">
          <mxGeometry x="20" y="42" width="250" height="52" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="Claude Code CLI&#10;ANTHROPIC_BASE_URL = {gw}/llm" style="rounded=1;html=0;whiteSpace=wrap;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="laneA">
          <mxGeometry x="20" y="116" width="250" height="52" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="x-api-key blanked (DD-5)&#10;the CLI sends the credential&#10;twice; the gateway 401s on&#10;the second one" style="rounded=0;html=0;whiteSpace=wrap;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="laneA">
          <mxGeometry x="20" y="190" width="250" height="74" as="geometry" />
        </mxCell>

        <mxCell id="laneC" value="Agentic Control Plane" style="swimlane;html=0;startSize=26;fontSize=12;fontStyle=1;fillColor=none;strokeColor=#9673a6;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="640" y="72" width="400" height="300" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="Portal — token exchange&#10;returns a delegated token, sub = the user" style="rounded=1;html=0;whiteSpace=wrap;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="laneC">
          <mxGeometry x="20" y="42" width="360" height="52" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="Gateway — Bearer token, SSE streams&#10;authn: JWT sub becomes the principal&#10;authz: access policy, caller to model  [GATE 1]" style="rounded=1;html=0;whiteSpace=wrap;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="laneC">
          <mxGeometry x="20" y="116" width="360" height="62" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="Provider account binding  [GATE 2]&#10;per (offering, project) — picks the AWS account&#10;STS session name luminate-{project}" style="rounded=1;html=0;whiteSpace=wrap;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="laneC">
          <mxGeometry x="20" y="196" width="360" height="62" as="geometry" />
        </mxCell>

        <mxCell id="laneD" value="Model AWS account" style="swimlane;html=0;startSize=26;fontSize=12;fontStyle=1;fillColor=none;strokeColor=#b85450;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1070" y="72" width="350" height="300" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="IAM allow-list  [GATE 3]&#10;InvokeApprovedBedrockModels" style="rounded=1;html=0;whiteSpace=wrap;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="laneD">
          <mxGeometry x="20" y="42" width="310" height="52" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="Marketplace subscription  [GATE 4]" style="rounded=1;html=0;whiteSpace=wrap;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="laneD">
          <mxGeometry x="20" y="116" width="310" height="42" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="Bedrock model" style="rounded=1;html=0;whiteSpace=wrap;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="laneD">
          <mxGeometry x="20" y="180" width="310" height="42" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="Gates 3 and 4 have DRIFTED (DD-6)" style="text;html=0;fontSize=10;align=center;fontColor=#b85450;fontStyle=1" vertex="1" parent="laneD">
          <mxGeometry x="20" y="240" width="310" height="20" as="geometry" />
        </mxCell>

        <mxCell id="laneE" value="Attribution — the same principal, all the way to finance (DD-7)" style="swimlane;html=0;startSize=26;fontSize=12;fontStyle=1;fillColor=none;strokeColor=#82b366;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="422" width="1390" height="130" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="Gateway principal&#10;user:uuid" style="rounded=1;html=0;whiteSpace=wrap;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="laneE">
          <mxGeometry x="20" y="48" width="225" height="52" as="geometry" />
