<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" modified="2026-08-31T00:00:00.000Z" agent="acp-product-specs" version="24.0.0" type="device">
  <diagram id="cah-target-state" name="CAH target state">
    <mxGraphModel dx="1800" dy="1100" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Agentic Cloud Provisioning Platform — target state, governed through an ACP-hosted gateway" style="text;html=0;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="12" width="1100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="D2 DD-1: a gateway is a luminate-portal Helm release inside an ACP cluster, dialling the control plane over an in-cluster service name. A gateway cannot run in CAH's cluster, so CAH egresses to one." style="text;html=0;fontSize=11;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="36" width="1200" height="20" as="geometry" />
        </mxCell>

        <mxCell id="callers" value="Callers — Backstage · C# Automation API · VS Code · Nova client&#10;present an ACP credential: X-API-Key or Authorization: Bearer lum_…" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacing=8;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="30" y="70" width="500" height="56" as="geometry" />
        </mxCell>

        <mxCell id="cahacct" value="CAH AWS account — ca-central-1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f9f9f9;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacing=8;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="146" width="500" height="812" as="geometry" />
        </mxCell>
        <mxCell id="caheks" value="agentic EKS cluster (DEV first, then SIT, then PROD)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#999999;verticalAlign=top;align=left;spacing=8;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="48" y="180" width="464" height="600" as="geometry" />
        </mxCell>

        <mxCell id="agret" value="CAH AgentGateway — retired from the governed path&#10;may remain for out-of-scope east-west traffic, documented as ungoverned" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fontColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="64" y="212" width="432" height="46" as="geometry" />
        </mxCell>

        <mxCell id="lg" value="LangGraph agents — each a registered ACP agent (DD-4)&#10;cah-nova · cah-cloudflux · cah-stratosphere&#10;one scoped lum_ key each → per-agent cost, audit, policy, containment&#10;no AWS credential in the pod (FR-9)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=6;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="64" y="274" width="432" height="80" as="geometry" />
        </mxCell>

        <mxCell id="split" value="MCP servers split by trust boundary (DD-5) — policy cannot see tools" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#eef7ee;strokeColor=#82b366;verticalAlign=top;align=left;spacing=6;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="64" y="370" width="432" height="196" as="geometry" />
        </mxCell>
        <mxCell id="t1" value="T1 read-only — broad grant&#10;cmdb-mcp · observability-mcp · datagravity-mcp · devtools-mcp · search_business_apps · search_computers" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#82b366;align=left;verticalAlign=top;spacing=6;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="78" y="398" width="404" height="46" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="T2 durable, no estate mutation — grant per agent&#10;cost analysis · APM utilisation · software audit · incident summary" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=6;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="78" y="452" width="404" height="46" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="T3 side-effecting on the estate — narrow grant, applications only&#10;provisioning-mcp: trigger_workload_provisioning · check_status · approve_provisioning&#10;token_forward — the backend validates ACP&#39;s issuer and sees the caller (FR-14)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#b85450;align=left;verticalAlign=top;spacing=6;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="78" y="506" width="404" height="46" as="geometry" />
        </mxCell>

        <mxCell id="a2a" value="A2A adapter — registered agent endpoint (DD-7)&#10;JSON-RPC 2.0 A2A v0.2 · delegated_identity_audience empty → gateway identity&#10;stops terminating Entra; NetworkPolicy admits only the ACP gateway" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=6;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="64" y="582" width="432" height="62" as="geometry" />
        </mxCell>

        <mxCell id="temporal" value="Temporal + workers — unchanged, and out of ACP scope&#10;ACP governs the submit → handle → status edge. No endpoints, namespaces, task queues or worker credentials cross to ACP. Port 5559 is not an ACP interface.&#10;Temporal&#39;s own OAuth is Entra&#39;s — Web UI SSO, workers, namespace claims. It receives an assertion in the workflow input, never an ACP token (DD-13)." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacing=6;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="64" y="660" width="432" height="70" as="geometry" />
        </mxCell>

        <mxCell id="npnote" value="NetworkPolicy on every MCP backend and the adapter is tightened from “admit AgentGateway” to “admit only the ACP gateway” — the compensating control for retiring the edge Entra check (DD-6)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#6c8ebf;dashed=1;align=left;verticalAlign=top;spacing=6;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="64" y="736" width="432" height="42" as="geometry" />
        </mxCell>

        <mxCell id="bedrock" value="Amazon Bedrock — stays in CAH's account (DD-3)&#10;role cah-bedrock-xaccount trusts ACP's hub role arn:aws:iam::035722575935:role/delegated/luminate-gateway-irsa&#10;least privilege: InvokeModel + Converse on approved model ARNs only — no ListFoundationModels" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacing=8;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="48" y="806" width="464" height="86" as="geometry" />
        </mxCell>

        <mxCell id="netpath" value="Cross-account&#10;network path&#10;&#10;peering /&#10;PrivateLink /&#10;Transit GW&#10;&#10;OWNER&#10;UNASSIGNED&#10;D-4" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="556" y="380" width="126" height="200" as="geometry" />
        </mxCell>

        <mxCell id="acpacct" value="ACP AWS account 035722575935 — slf-eks-t1k-ca-prod, ca-central-1&#10;the single control plane for every workload environment (DD-1)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f9f9f9;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacing=8;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="710" y="146" width="680" height="812" as="geometry" />
        </mxCell>

        <mxCell id="traefik" value="Traefik Gateway API — gw-cah-dev.apps.slf-eks-t1k-ca-prod.aws.sunlifecorp.com&#10;Venafi multi-SAN certificate, Sun Life Financial Issuing CA3&#10;BLOCKED — no hostname, no DNS record, no SAN exists today. EACPP-1155, status Funnel (G-A)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacing=8;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="730" y="200" width="640" height="70" as="geometry" />
        </mxCell>

        <mxCell id="gwns" value="namespace luminate-gw-cah-dev — one Helm release per CAH environment × Bedrock spoke account (DD-2)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacing=8;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="730" y="284" width="640" height="240" as="geometry" />
        </mxCell>
        <mxCell id="lg1" value="Luminate gateway process (LG1)&#10;authn: X-API-Key · Bearer lum_ · lud_at_ · JWT&#10;authz: gRPC CheckAccess per request, fail-closed&#10;guardrails: request + response, block / redact / warn&#10;stamps x-luminate-entity-*, -model-*, -session-id" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=6;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="746" y="314" width="304" height="96" as="geometry" />
        </mxCell>
        <mxCell id="agw" value="agentgateway v1.4.1&#10;the same binary CAH already runs&#10;/llm → :4000  ·  /mcp → :3000  ·  /a2a → :5000&#10;internal listeners, not a client contract" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=6;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1062" y="314" width="292" height="96" as="geometry" />
        </mxCell>
        <mxCell id="paths" value="Client-facing surface: one host, three prefixes  —  /llm/v1/chat/completions  ·  /llm/v1/embeddings  ·  /mcp/{endpoint}/…  ·  /a2a/{endpoint}/…&#10;AWS identity: pod-level ~/.aws/config — [profile base] web identity → hub role, [profile chain] → one spokeRoleArn per release" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eef4fb;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=6;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="746" y="420" width="608" height="46" as="geometry" />
        </mxCell>
        <mxCell id="ddnote" value="DD-2: the gateway release is the failure domain, the capacity pool and the kill boundary. Scaling it to zero is the only true stop." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=6;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="746" y="474" width="608" height="34" as="geometry" />
        </mxCell>

        <mxCell id="cpns" value="namespace luminate — control plane" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;align=left;spacing=8;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="730" y="546" width="640" height="192" as="geometry" />
        </mxCell>
        <mxCell id="backend" value="luminate-backend&#10;luminate-backend.luminate.svc.cluster.local:50051, plaintext, in-cluster&#10;• luminate.authz.v1.Authz/CheckAccess — per request, deny on portal_unreachable&#10;• GatewayManagement.Connect — long-lived bidi stream, ConfigPushed on change&#10;• registries, RBAC, access policies, approvals, audit_events, ProjectUsageDaily&#10;NetworkPolicy admits gateways by namespace — networkPolicy.extraGatewayNamespaces" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#9673a6;align=left;verticalAlign=top;spacing=6;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="746" y="578" width="608" height="104" as="geometry" />
        </mxCell>
        <mxCell id="idp" value="Identity: Keycloak in-cluster (gateway OAuth clients) · portal human SSO is direct Entra  ·  SERVICE_PRINCIPAL_AUTH_ENABLED = “false” in all four environments (G-J)&#10;Keycloak federates identity INWARD — it issues for registered ACP entities only, never for a third-party relying party" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5eef7;strokeColor=#9673a6;align=left;verticalAlign=top;spacing=6;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="746" y="690" width="608" height="34" as="geometry" />
        </mxCell>

        <mxCell id="obs" value="namespace luminate-observability — Langfuse + ClickHouse&#10;one instance, one project per environment cluster — CAH does not get its own project (G-K).&#10;Tenancy is by attribution header; sessions namespaced {entity_type}:{entity_id}:{raw} (DD-9).&#10;There is no external OTLP receiver — ACP sees a call because it traversed this gateway." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=8;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="730" y="764" width="640" height="84" as="geometry" />
        </mxCell>

        <mxCell id="evid" value="Evidence allocation (DD-10)  —  traces: ACP  ·  authorization decisions: ACP  ·  registry snapshots: ACP  ·  approvals: Backstage + Temporal, joined on the handle.&#10;audit_events states there is deliberately no public producer REST endpoint, so ACP records the authorized approve_provisioning call, not the human decision behind it (G-I)." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#666666;dashed=1;align=left;verticalAlign=top;spacing=8;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="730" y="866" width="640" height="72" as="geometry" />
        </mxCell>

        <mxCell id="ed1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#333333;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="callers" target="traefik">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="619" y="98" /><mxPoint x="619" y="217" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="ed2" value="TLS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#333333;fontSize=9;" edge="1" parent="1" source="traefik" target="gwns">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ed3" value="agent → gateway&#10;lum_ key + session id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#333333;strokeWidth=2;fontSize=9;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lg" target="netpath">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ed4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#333333;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="netpath" target="gwns">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ed5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;dashed=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=9;exitX=0;exitY=0.9;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gwns" target="split">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="619" y="495" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="ed6" value="CheckAccess per request, fail-closed  ↑&#10;ConfigPushed bidi stream  ↓" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;startArrow=block;strokeColor=#9673a6;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="gwns" target="cpns">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ed7" value="spans + Langfuse trace" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;dashed=1;strokeColor=#82b366;fontSize=9;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=1;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="gwns" target="obs">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1396" y="495" /><mxPoint x="1396" y="781" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="ed8" value="SigV4 — hub role (ACP) → spoke role (CAH)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#d79b00;strokeWidth=3;fontSize=10;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="gwns" target="bedrock">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="543" y="334" /><mxPoint x="543" y="849" /></Array></mxGeometry>
        </mxCell>
      <mxCell id="retlbl" vertex="1" parent="1" value="/mcp/{endpoint} · /a2a/{endpoint}&#10;identity mode per trust tier (DD-6)" style="text;html=0;fontSize=9;align=center;verticalAlign=middle;fontColor=#6c8ebf;"><mxGeometry as="geometry" x="540" y="596" width="160" height="26" /></mxCell></root>
    </mxGraphModel>
  </diagram>
