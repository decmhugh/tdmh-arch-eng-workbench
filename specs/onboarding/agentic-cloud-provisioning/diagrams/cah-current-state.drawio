        <mxCell id="ag" value="Solo.io AgentGateway v1.4.1 — the trust boundary and tool proxy" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacing=8;fontStyle=1;fontSize=12;" vertex="1" parent="1">
