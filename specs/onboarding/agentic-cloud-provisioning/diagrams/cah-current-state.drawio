        <mxCell id="l5555" value=":5555 HTTPS — edge&#10;MCP, LangGraph routes, AG-fronted REST&#10;Entra jwtAuth, mode: strict&#10;+ authorization.rules on jwt.appid / jwt.tid&#10;TLS terminated in-pod" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=6;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="70" y="326" width="285" height="100" as="geometry" />
        </mxCell>
        <mxCell id="l5557" value=":5557 HTTP — east-west, three postures on one port&#10;• /mcp — no jwtAuth, pod identity + NetworkPolicy&#10;• A2A catch-all — Entra jwtAuth, audience pinned&#10;• /v1/chat/completions, /v1/embeddings — apiKey" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=6;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="368" y="326" width="290" height="100" as="geometry" />
        </mxCell>
        <mxCell id="lout" value="Outbound to Bedrock&#10;SigV4, primary identity IRSA on the&#10;AgentGateway ServiceAccount;&#10;IAM-user-in-Vault fallback&#10;:19000 adminAddr, localhost-bound" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=6;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="671" y="326" width="280" height="100" as="geometry" />
        </mxCell>

        <mxCell id="lg" value="LangGraph agents&#10;Nova · CloudFlux · Stratosphere&#10;&#10;AGENT_PROFILE personas, entitled_tools&#10;per profile, identity lock, route allow-list&#10;&#10;MCP clients of AgentGateway" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=6;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="55" y="468" width="270" height="112" as="geometry" />
        </mxCell>
        <mxCell id="mcp" value="Federated MCP backends — nine&#10;webhook-receiver (provisioning-tools) · provisioning-mcp ·&#10;finops-mcp · cmdb-mcp · observability-mcp · secops-mcp ·&#10;devtools-mcp · aws-identity-mcp · datagravity-mcp&#10;&#10;Read-only helpers and side-effecting provisioning tools&#10;share a server — see D2 DD-5" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=6;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="340" y="468" width="350" height="112" as="geometry" />
        </mxCell>
        <mxCell id="a2a" value="A2A adapter&#10;GET /.well-known/agent.json&#10;JSON-RPC 2.0 A2A v0.2 tasks/send&#10;SSE tasks/sendSubscribe&#10;&#10;Holds only a Temporal client&#10;NetworkPolicy: AgentGateway only" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=6;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="705" y="468" width="260" height="112" as="geometry" />
        </mxCell>

        <mxCell id="hooks" value="webhook-receiver HTTP doors (AG-fronted)&#10;POST /trigger-workload-provisioning · GET /workload-provisioning-status/{workflow_id} · approve · reject&#10;WEBHOOK_AUTH_TOKEN is bypassed for AG-fronted prefixes — the gateway is the only thing in front" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=6;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="340" y="598" width="350" height="78" as="geometry" />
        </mxCell>

        <mxCell id="temporal" value="Temporal + workers — durable execution inside CAH's boundary&#10;8-phase workload provisioning workflow · retries, timeouts, persistence · opaque handle workload-acct-{name}-{8 hex}&#10;worker → Temporal gRPC on :5559 — engine-internal, explicitly not an ACP interface" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacing=8;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="55" y="700" width="910" height="84" as="geometry" />
        </mxCell>

        <mxCell id="bedrock" value="Amazon Bedrock&#10;CAH workload account&#10;&#10;us.anthropic.claude-&#10;sonnet-4-5&#10;claude-opus pin&#10;titan-embed-text-v2&#10;&#10;callers ca-central-1;&#10;model may resolve&#10;us-east-1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacing=6;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1015" y="326" width="195" height="200" as="geometry" />
        </mxCell>

        <mxCell id="note" value="What is missing today&#10;• No central registry — the approved set lives in CAH config&#10;• No first-party traceparent; LangGraph mints a server-side UUID request_id&#10;• Token tracking only; no cost, no budget, no chargeback join&#10;• No external policy authority; guardrails are product-level, not platform-level" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#b85450;dashed=1;align=left;verticalAlign=top;spacing=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1015" y="560" width="195" height="224" as="geometry" />
        </mxCell>

