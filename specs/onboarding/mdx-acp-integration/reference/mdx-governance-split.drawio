<mxfile host="app.diagrams.net" type="device">
  <diagram id="mdx-governance-split" name="MDx governance split">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1140" pageHeight="670" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="acpBox" value="ACP / Luminate — governance owner" style="rounded=1;html=0;whiteSpace=wrap;fillColor=#FFFBEA;strokeColor=#D4A700;strokeWidth=2;verticalAlign=top;fontSize=15;fontStyle=1;spacingTop=8;" vertex="1" parent="1">
