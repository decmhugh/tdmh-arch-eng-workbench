        <mxCell id="gwy" value="agentgateway&#10;/llm/v1/chat/completions" style="rounded=1;html=0;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#D4A700;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="1">
