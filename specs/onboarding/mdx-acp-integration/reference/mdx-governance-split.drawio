        <mxCell id="pol" value="Policy authorship&#10;model access · execution · budget" style="rounded=1;html=0;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D4A700;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="310" y="90" width="240" height="55" as="geometry" />
        </mxCell>
