        <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#607d8b;strokeWidth=2;endArrow=block;endFill=1;exitX=0;exitY=0.85;entryX=1;entryY=0.85;dashed=1;" edge="1" parent="1" source="resBox" target="usecase">
