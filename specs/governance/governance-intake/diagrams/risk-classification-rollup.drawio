<mxfile host="app.diagrams.net" agent="acp-product-specs" version="24.7.17">
  <diagram id="risk-classification-rollup" name="Risk classification roll-up">
    <mxGraphModel dx="1800" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1820" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Risk classification — how agent, model and MCP-server bands relate to the AI use case" style="text;html=0;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#263238;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1100" height="28" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="The use case classification sets the bounds. A resource classification is checked against them — it does not sum into them." style="text;html=0;align=left;verticalAlign=middle;fontSize=12;fontColor=#546e7a;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="1200" height="20" as="geometry" />
        </mxCell>

        <!-- ===== GOVERNANCE BY DESIGN LANE ===== -->
        <mxCell id="gbdLane" value="" style="rounded=1;arcSize=6;html=0;fillColor=#ede7f6;strokeColor=#5e35b1;strokeWidth=1;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="96" width="380" height="470" as="geometry" />
        </mxCell>
        <mxCell id="gbdLaneT" value="GOVERNANCE INTAKE &amp; RISK TRIAGE" style="text;html=0;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#5e35b1;" vertex="1" parent="1">
          <mxGeometry x="58" y="106" width="300" height="18" as="geometry" />
        </mxCell>
        <mxCell id="gbdLaneS" value="owns the use-case classification and every re-classification" style="text;html=0;align=left;verticalAlign=top;fontSize=10;fontColor=#7e57c2;" vertex="1" parent="1">
          <mxGeometry x="58" y="124" width="340" height="16" as="geometry" />
        </mxCell>

        <mxCell id="intake" value="Use-case intake" style="rounded=1;arcSize=10;html=0;fillColor=#ffffff;strokeColor=#5e35b1;fontSize=12;fontStyle=1;fontColor=#37474f;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="64" y="156" width="332" height="62" as="geometry" />
        </mxCell>
        <mxCell id="intakeS" value="pre-populated from the exported use-case pack — not blank" style="text;html=0;align=center;fontSize=10;fontColor=#2e7d32;" vertex="1" parent="1">
          <mxGeometry x="64" y="192" width="332" height="16" as="geometry" />
        </mxCell>

        <mxCell id="triage" value="Risk triage — CMRM questionnaire" style="rounded=1;arcSize=10;html=0;fillColor=#ffffff;strokeColor=#5e35b1;fontSize=12;fontStyle=1;fontColor=#37474f;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="64" y="244" width="332" height="96" as="geometry" />
        </mxCell>
        <mxCell id="triageS" value="Impact-led: worst credible outcome for a person.&#10;5 impact + 7 likelihood questions → AA / A / B / C / D.&#10;Inherent — scored before any control is credited." style="text;html=0;align=left;verticalAlign=top;fontSize=10;fontColor=#78909c;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="64" y="278" width="332" height="56" as="geometry" />
        </mxCell>

        <mxCell id="approve" value="Explicit risk approval" style="rounded=1;arcSize=10;html=0;fillColor=#ffffff;strokeColor=#5e35b1;fontSize=12;fontStyle=1;fontColor=#37474f;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="64" y="366" width="332" height="58" as="geometry" />
        </mxCell>
        <mxCell id="approveS" value="A band the platform computes is a proposal until this lands" style="text;html=0;align=center;fontSize=10;fontColor=#78909c;" vertex="1" parent="1">
          <mxGeometry x="64" y="398" width="332" height="16" as="geometry" />
        </mxCell>

        <mxCell id="reclass" value="Re-classification happens here — not in the control plane" style="rounded=1;arcSize=10;html=0;fillColor=#f3e5f5;strokeColor=#8e24aa;fontSize=11;fontStyle=1;fontColor=#6a1b9a;align=center;" vertex="1" parent="1">
          <mxGeometry x="64" y="450" width="332" height="44" as="geometry" />
        </mxCell>
        <mxCell id="openq1" value="OPEN — does a breached agent trigger a use-case&#10;re-classification, or must the use case move first?" style="text;html=0;align=left;verticalAlign=top;fontSize=10;fontColor=#c62828;spacingLeft=4;" vertex="1" parent="1">
          <mxGeometry x="74" y="504" width="340" height="34" as="geometry" />
        </mxCell>

        <!-- ===== ACP LANE ===== -->
        <mxCell id="acpLane" value="" style="rounded=1;arcSize=4;html=0;fillColor=#f5f9ff;strokeColor=#1565c0;strokeWidth=1;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="470" y="96" width="1310" height="470" as="geometry" />
        </mxCell>
        <mxCell id="acpLaneT" value="AGENTIC CONTROL PLANE" style="text;html=0;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#1565c0;" vertex="1" parent="1">
          <mxGeometry x="488" y="106" width="400" height="18" as="geometry" />
        </mxCell>
        <mxCell id="acpLaneS" value="computes and publishes bands · never decides the rigor they require" style="text;html=0;align=left;verticalAlign=top;fontSize=10;fontColor=#1976d2;" vertex="1" parent="1">
          <mxGeometry x="488" y="124" width="480" height="16" as="geometry" />
        </mxCell>

        <!-- Use case hub -->
        <mxCell id="usecase" value="AI USE CASE" style="rounded=1;arcSize=8;html=0;fillColor=#fff8e1;strokeColor=#f9a825;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#8d6e00;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="498" y="160" width="300" height="200" as="geometry" />
        </mxCell>
        <mxCell id="usecaseS" value="= a platform project&#10;&#10;use-case band  (low … critical)&#10;APM ref · governance intake ref&#10;&#10;This band is the ceiling every&#10;resource inside must sit under." style="text;html=0;align=left;verticalAlign=top;fontSize=11;fontColor=#6d5200;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="498" y="196" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="ucGap" value="GAP — the platform does not sweep or band a project.&#10;The band can be stored on it; nothing enforces it." style="rounded=1;arcSize=12;html=0;fillColor=#ffebee;strokeColor=#c62828;fontSize=10;fontColor=#b71c1c;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="498" y="370" width="300" height="46" as="geometry" />
        </mxCell>

        <!-- Resources -->
        <mxCell id="resBox" value="" style="rounded=1;arcSize=6;html=0;fillColor=#fafafa;strokeColor=#b0bec5;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="866" y="160" width="472" height="256" as="geometry" />
        </mxCell>
        <mxCell id="resBoxT" value="GOVERNED RESOURCES — classified by the control plane" style="text;html=0;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#546e7a;" vertex="1" parent="1">
          <mxGeometry x="882" y="170" width="440" height="18" as="geometry" />
