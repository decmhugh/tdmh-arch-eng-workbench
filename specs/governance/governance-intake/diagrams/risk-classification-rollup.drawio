        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#f9a825;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.25;entryX=0;entryY=0.2;" edge="1" parent="1" source="usecase" target="resBox">
          <mxGeometry relative="1" as="geometry" />
