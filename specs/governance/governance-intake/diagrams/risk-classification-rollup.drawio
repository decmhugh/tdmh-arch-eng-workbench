          <mxGeometry x="882" y="196" width="440" height="60" as="geometry" />
        </mxCell>
        <mxCell id="agentS" value="autonomy · tools bound · destructive capability · data reach&#10;credentials · MCP servers bound · delegation" style="text;html=0;align=left;verticalAlign=top;fontSize=10;fontColor=#78909c;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="882" y="220" width="440" height="32" as="geometry" />
        </mxCell>

        <mxCell id="model" value="Model" style="rounded=1;arcSize=12;html=0;fillColor=#ffffff;strokeColor=#1565c0;fontSize=12;fontStyle=1;fontColor=#37474f;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="882" y="264" width="440" height="52" as="geometry" />
        </mxCell>
        <mxCell id="modelS" value="OSFI E-23 model risk tier · region · approval state" style="text;html=0;align=left;verticalAlign=top;fontSize=10;fontColor=#78909c;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="882" y="288" width="440" height="20" as="geometry" />
        </mxCell>

        <mxCell id="mcp" value="MCP server" style="rounded=1;arcSize=12;html=0;fillColor=#ffffff;strokeColor=#1565c0;fontSize=12;fontStyle=1;fontColor=#37474f;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="882" y="324" width="440" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mcpS" value="data classification · PII / PCI / government data&#10;destructive tools · inbound auth · outbound credentials" style="text;html=0;align=left;verticalAlign=top;fontSize=10;fontColor=#78909c;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="882" y="348" width="440" height="32" as="geometry" />
        </mxCell>

        <mxCell id="resNote" value="A different instrument at each level. The use case asks what could happen to a person;&#10;a resource asks what it can reach and what authority it holds." style="text;html=0;align=left;verticalAlign=top;fontSize=10;fontColor=#546e7a;spacingLeft=2;" vertex="1" parent="1">
          <mxGeometry x="866" y="424" width="480" height="32" as="geometry" />
        </mxCell>

        <!-- Containment check -->
        <mxCell id="check" value="CONTAINMENT CHECK" style="rounded=1;arcSize=8;html=0;fillColor=#ffffff;strokeColor=#37474f;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#263238;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1406" y="160" width="358" height="118" as="geometry" />
        </mxCell>
        <mxCell id="checkS" value="Is each resource band at or below&#10;the use-case band?&#10;Runs continuously, not once at intake." style="text;html=0;align=left;verticalAlign=top;fontSize=10;fontColor=#546e7a;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="1406" y="196" width="358" height="50" as="geometry" />
        </mxCell>

        <mxCell id="ok" value="Within bounds — no action" style="rounded=1;arcSize=12;html=0;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=11;fontStyle=1;fontColor=#1b5e20;" vertex="1" parent="1">
          <mxGeometry x="1406" y="298" width="358" height="40" as="geometry" />
        </mxCell>

        <mxCell id="breach" value="Above bounds — divergence finding" style="rounded=1;arcSize=12;html=0;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#b71c1c;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1406" y="354" width="358" height="92" as="geometry" />
        </mxCell>
        <mxCell id="breachS" value="The agent grew past what the use case&#10;was assessed for. The control plane raises it;&#10;governance decides whether to re-classify." style="text;html=0;align=left;verticalAlign=top;fontSize=10;fontColor=#c62828;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="1406" y="380" width="358" height="52" as="geometry" />
