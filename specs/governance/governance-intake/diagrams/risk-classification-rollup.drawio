        <mxCell id="a5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;strokeColor=#c62828;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="breach" target="reclass">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1585" y="604" /><mxPoint x="24" y="604" /><mxPoint x="24" y="472" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a5L" value="finding goes back to governance — the control plane detects, governance decides" style="edgeLabel;html=0;align=center;fontSize=10;fontStyle=1;fontColor=#c62828;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="a5">
          <mxGeometry x="0.1" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- ===== ENVIRONMENT STRIP ===== -->
        <mxCell id="envBox" value="" style="rounded=1;arcSize=4;html=0;fillColor=#eceff1;strokeColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="40" y="644" width="1740" height="116" as="geometry" />
        </mxCell>
        <mxCell id="envT" value="WHEN A BAND BITES" style="text;html=0;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#37474f;" vertex="1" parent="1">
          <mxGeometry x="58" y="654" width="300" height="18" as="geometry" />
        </mxCell>
        <mxCell id="envS" value="Classification runs everywhere from the start. What changes by environment is whether it blocks." style="text;html=0;align=left;verticalAlign=top;fontSize=10;fontColor=#607d8b;" vertex="1" parent="1">
          <mxGeometry x="58" y="672" width="760" height="16" as="geometry" />
        </mxCell>

        <mxCell id="envDev" value="DEV · SIT — observe" style="rounded=1;arcSize=12;html=0;fillColor=#ffffff;strokeColor=#2e7d32;fontSize=11;fontStyle=1;fontColor=#1b5e20;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="58" y="696" width="530" height="48" as="geometry" />
        </mxCell>
        <mxCell id="envDevS" value="Self-serve. Bands are computed and recorded; nothing is denied." style="text;html=0;align=left;verticalAlign=top;fontSize=10;fontColor=#78909c;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="58" y="718" width="530" height="20" as="geometry" />
        </mxCell>

        <mxCell id="envGate" value="PROMOTION GATE" style="rounded=1;arcSize=12;html=0;fillColor=#fff8e1;strokeColor=#f9a825;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#8d6e00;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="612" y="696" width="530" height="48" as="geometry" />
        </mxCell>
        <mxCell id="envGateS" value="Export the pack → pre-populate intake → approval → obligations for the target band." style="text;html=0;align=left;verticalAlign=top;fontSize=10;fontColor=#8d6e00;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="612" y="718" width="530" height="20" as="geometry" />
        </mxCell>

        <mxCell id="envProd" value="STAGE · PROD — enforce" style="rounded=1;arcSize=12;html=0;fillColor=#ffffff;strokeColor=#c62828;fontSize=11;fontStyle=1;fontColor=#b71c1c;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1166" y="696" width="596" height="48" as="geometry" />
        </mxCell>
        <mxCell id="envProdS" value="A resource outside its use case&apos;s bounds does not run." style="text;html=0;align=left;verticalAlign=top;fontSize=10;fontColor=#78909c;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1166" y="718" width="596" height="20" as="geometry" />
        </mxCell>

        <!-- ===== INHERENT VS CONTROLS ===== -->
        <mxCell id="inhBox" value="" style="rounded=1;arcSize=4;html=0;fillColor=#fbf6f6;strokeColor=#efd3d3;" vertex="1" parent="1">
          <mxGeometry x="40" y="784" width="1740" height="140" as="geometry" />
        </mxCell>
        <mxCell id="inhT" value="INHERENT RISK, AND CONTROLS KEPT SEPARATE FROM IT" style="text;html=0;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#b71c1c;" vertex="1" parent="1">
          <mxGeometry x="58" y="794" width="620" height="18" as="geometry" />
        </mxCell>
        <mxCell id="inhS" value="Model risk is tracked on an inherent basis — scored independently of the controls, with controls carried alongside as mitigations.&#10;A control must never quietly lower a band, or the register stops showing what is actually being run." style="text;html=0;align=left;verticalAlign=top;fontSize=10;fontColor=#8d6e00;" vertex="1" parent="1">
          <mxGeometry x="58" y="812" width="1000" height="32" as="geometry" />
        </mxCell>

        <mxCell id="inh1" value="INHERENT — what it could do" style="rounded=1;arcSize=12;html=0;fillColor=#ffffff;strokeColor=#c62828;fontSize=11;fontStyle=1;fontColor=#b71c1c;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="58" y="850" width="840" height="56" as="geometry" />
        </mxCell>
        <mxCell id="inh1S" value="data reach · autonomy · destructive capability · external exposure · regulatory scope · model tier&#10;This alone produces the band." style="text;html=0;align=left;verticalAlign=top;fontSize=10;fontColor=#78909c;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="58" y="872" width="840" height="30" as="geometry" />
        </mxCell>

        <mxCell id="inh2" value="CONTROLS — carried, not netted off" style="rounded=1;arcSize=12;html=0;fillColor=#ffffff;strokeColor=#2e7d32;fontSize=11;fontStyle=1;fontColor=#1b5e20;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="922" y="850" width="840" height="56" as="geometry" />
        </mxCell>
        <mxCell id="inh2S" value="registration + ownership · inbound authentication · human review · evaluations · guardrails&#10;Tracked as mitigations against the obligations the band demands." style="text;html=0;align=left;verticalAlign=top;fontSize=10;fontColor=#78909c;spacingLeft=12;" vertex="1" parent="1">
